{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SemanticDataCharter/sdcvalidator-ts",
  "description": "Validate and recover SDC4 Governed Data Records in TypeScript, conforming to sdcvalidator.",
  "repository": {
    "url": "https://github.com/SemanticDataCharter/sdcvalidator-ts",
    "source": "github"
  },
  "version": "4.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sdcvalidator-ts",
      "version": "4.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP stdio server."
        }
      ]
    }
  ]
}
